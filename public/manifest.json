{
  "manifest_version": 3,
  "name": "LeetCode AutoCommit",
  "version": "0.1.2",
  "description": "Keep accepted LeetCode solutions and revision notes in your GitHub repository.",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://leetcode.com/*", "https://api.github.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [{ "matches": ["https://leetcode.com/problems/*", "https://leetcode.com/submissions/detail/*"], "js": ["content.js"], "run_at": "document_idle" }],
  "action": { "default_popup": "popup.html" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
